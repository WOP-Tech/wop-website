# Modèle des variables d'environnement. Copier en .env.local (jamais committé) et remplir.
# Sur Vercel : Project → Settings → Environment Variables.

# URL publique du site, sans barre finale (métadonnées, sitemap, liens des e-mails)
NEXT_PUBLIC_SITE_URL=https://womanofpower.org

# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# ⚠️ Clé secrète « service_role » : serveur uniquement, ne jamais la préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend (Domains)
EMAIL_FROM="Woman of Power <contact@womanofpower.org>"
# Boîte qui reçoit les messages du formulaire de contact (par défaut : womanofpower.wop@gmail.com)
CONTACT_INBOX=womanofpower.wop@gmail.com
